# GEMINI_API_KEY: Optional key for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenRouter API: Used as AI provider for ATS Checker analysis & cover letter generation.
# In Vite client apps (and Vercel), prefix with VITE_ to expose to client bundle.
VITE_OPENROUTER_API_KEY="your_openrouter_api_key_here"
VITE_OPENROUTER_TIMEOUT_SECONDS=60
DEV=true

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
